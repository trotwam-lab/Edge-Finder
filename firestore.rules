rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The user document itself holds subscription fields (subscriptionTier,
    // subscriptionStatus, stripeCustomerId) that the server reads to decide
    // who is Pro. Only the Stripe webhook (Admin SDK, which bypasses these
    // rules) may write it — a client write here would self-grant Pro.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;

      // Everything under the user document is the user's own data: synced
      // bets (data/bets) and daily backups (bets_snapshots/{date}).
      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
